# Master Production Environment Variables

# PostgreSQL Database Secrets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=strapi_db

# Strapi Backend Secrets
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT="secure_api_token_salt"
ADMIN_JWT_SECRET="secure_admin_jwt_secret"
TRANSFER_TOKEN_SALT="secure_transfer_token_salt"
JWT_SECRET="secure_jwt_secret"

# Public Domains
PUBLIC_STRAPI_URL=https://api.yourdomain.com
PUBLIC_FRONTEND_URL=https://yourdomain.com

# Cloudflare Zero Trust Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE
